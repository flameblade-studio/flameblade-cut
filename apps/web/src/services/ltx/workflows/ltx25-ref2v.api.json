{
  "ref.sheet": { "class_type": "LoadImage", "inputs": { "image": "" }, "_meta": { "title": "Reference sheet" } },
  "ref.prompt": { "class_type": "PrimitiveStringMultiline", "inputs": { "value": "" }, "_meta": { "title": "Prompt" } },
  "ref.negative": { "class_type": "PrimitiveStringMultiline", "inputs": { "value": "" }, "_meta": { "title": "Negative prompt" } },
  "ref.fps": { "class_type": "PrimitiveFloat", "inputs": { "value": 24 }, "_meta": { "title": "Frame rate" } },
  "ref.duration": { "class_type": "PrimitiveFloat", "inputs": { "value": 5 }, "_meta": { "title": "Duration" } },
  "ref.frames": {
    "class_type": "ComfyMathExpression",
    "inputs": { "expression": "1 + floor(a*b/8)*8", "values.a": ["ref.fps", 0], "values.b": ["ref.duration", 0] },
    "_meta": { "title": "Frame count" }
  },

  "ref.unet": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "ltx-2.5-22b-distilled-transformer-nvfp4.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Video model" }
  },
  "ref.lora": {
    "class_type": "LTXICLoRALoaderModelOnly",
    "inputs": { "lora_name": "ltx-2.5-22b-ic-lora-ingredients-0.9.safetensors", "strength_model": 1.3, "model": ["ref.unet", 0] },
    "_meta": { "title": "Ingredients IC-LoRA" }
  },
  "ref.textEncoder": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default" },
    "_meta": { "title": "Text encoder" }
  },
  "ref.videoVae": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-video-vae-conv-bf16.safetensors" }, "_meta": { "title": "Video VAE" } },
  "ref.audioVae": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-audio-vae-bf16.safetensors" }, "_meta": { "title": "Audio VAE" } },

  "ref.positive": { "class_type": "CLIPTextEncode", "inputs": { "text": ["ref.prompt", 0], "clip": ["ref.textEncoder", 0] }, "_meta": { "title": "Encode prompt" } },
  "ref.negativeEncoded": { "class_type": "CLIPTextEncode", "inputs": { "text": ["ref.negative", 0], "clip": ["ref.textEncoder", 0] }, "_meta": { "title": "Encode negative prompt" } },
  "ref.conditioning": {
    "class_type": "LTXVConditioning",
    "inputs": { "frame_rate": ["ref.fps", 0], "positive": ["ref.positive", 0], "negative": ["ref.negativeEncoded", 0] },
    "_meta": { "title": "Conditioning" }
  },

  "ref.sheetResized": {
    "class_type": "ResizeImageMaskNode",
    "inputs": { "resize_type": "scale shorter dimension", "resize_type.shorter_size": 544, "scale_method": "lanczos", "input": ["ref.sheet", 0] },
    "_meta": { "title": "Sheet at model size" }
  },
  "ref.sheetSize": { "class_type": "GetImageSize", "inputs": { "image": ["ref.sheetResized", 0] }, "_meta": { "title": "Video size from sheet" } },
  "ref.sheetFrames": { "class_type": "RepeatImageBatch", "inputs": { "amount": ["ref.frames", 1], "image": ["ref.sheetResized", 0] }, "_meta": { "title": "Sheet on every frame" } },
  "ref.videoLatent": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": { "width": ["ref.sheetSize", 0], "height": ["ref.sheetSize", 1], "length": ["ref.frames", 1], "batch_size": 1 },
    "_meta": { "title": "Empty video latent" }
  },
  "ref.guide": {
    "class_type": "LTXAddVideoICLoRAGuide",
    "inputs": {
      "frame_idx": 0,
      "strength": 1,
      "latent_downscale_factor": ["ref.lora", 1],
      "crop": "disabled",
      "use_tiled_encode": false,
      "tile_size": 256,
      "tile_overlap": 64,
      "use_streaming": false,
      "tile_frames": 97,
      "positive": ["ref.conditioning", 0],
      "negative": ["ref.conditioning", 1],
      "vae": ["ref.videoVae", 0],
      "latent": ["ref.videoLatent", 0],
      "image": ["ref.sheetFrames", 0]
    },
    "_meta": { "title": "Reference guide" }
  },
  "ref.audioLatent": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": { "frames_number": ["ref.frames", 1], "frame_rate": ["ref.fps", 0], "batch_size": 1, "audio_vae": ["ref.audioVae", 0] },
    "_meta": { "title": "Empty audio latent" }
  },
  "ref.avLatent": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": { "video_latent": ["ref.guide", 2], "audio_latent": ["ref.audioLatent", 0] },
    "_meta": { "title": "Audio + video latent" }
  },

  "ref.noise": { "class_type": "RandomNoise", "inputs": { "noise_seed": 42 }, "_meta": { "title": "Seed" } },
  "ref.guider": {
    "class_type": "CFGGuider",
    "inputs": { "cfg": 1, "model": ["ref.lora", 0], "positive": ["ref.guide", 0], "negative": ["ref.guide", 1] },
    "_meta": { "title": "Guider" }
  },
  "ref.sampler": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler_ancestral_cfg_pp" }, "_meta": { "title": "Sampler" } },
  "ref.sigmas": {
    "class_type": "ManualSigmas",
    "inputs": { "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0" },
    "_meta": { "title": "Distilled schedule" }
  },
  "ref.sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": { "noise": ["ref.noise", 0], "guider": ["ref.guider", 0], "sampler": ["ref.sampler", 0], "sigmas": ["ref.sigmas", 0], "latent_image": ["ref.avLatent", 0] },
    "_meta": { "title": "Sample" }
  },
  "ref.split": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["ref.sample", 0] }, "_meta": { "title": "Split audio and video" } },
  "ref.cropGuides": {
    "class_type": "LTXVCropGuides",
    "inputs": { "positive": ["ref.guide", 0], "negative": ["ref.guide", 1], "latent": ["ref.split", 0] },
    "_meta": { "title": "Drop guide frames" }
  },
  "ref.decodeVideo": {
    "class_type": "VAEDecodeTiled",
    "inputs": { "tile_size": 512, "overlap": 64, "temporal_size": 128, "temporal_overlap": 32, "samples": ["ref.cropGuides", 2], "vae": ["ref.videoVae", 0] },
    "_meta": { "title": "Decode video" }
  },
  "ref.decodeAudio": { "class_type": "LTXVAudioVAEDecode", "inputs": { "samples": ["ref.split", 1], "audio_vae": ["ref.audioVae", 0] }, "_meta": { "title": "Decode audio" } },
  "ref.video": {
    "class_type": "CreateVideo",
    "inputs": { "fps": ["ref.fps", 0], "bit_depth": 8, "color_space": "sRGB", "codec": "none", "images": ["ref.decodeVideo", 0], "audio": ["ref.decodeAudio", 0] },
    "_meta": { "title": "Assemble video" }
  },
  "ref.save": {
    "class_type": "SaveVideo",
    "inputs": { "filename_prefix": "flameblade-cut/ref2v", "format": "auto", "format.codec": "auto", "codec": "auto", "video": ["ref.video", 0] },
    "_meta": { "title": "Save video" }
  }
}
